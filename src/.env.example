# Exemple de configuration — copier vers src/.env et remplir avec vos valeurs.
# NE JAMAIS committer src/.env (déjà ignoré par .gitignore).
# Toutes les valeurs ci-dessous sont des PLACEHOLDERS.

# --- Serveur ---
PORT=3001
# HOST=0.0.0.0

# --- Accès admin (OBLIGATOIRE en production) ---
# Choisir un mot de passe fort et unique. Ne pas réutiliser d'exemple.
ADMIN_PASSWORD=CHANGE_ME_strong_unique_password
# Secret long et aléatoire pour signer la session admin.
ADMIN_SESSION_SECRET=CHANGE_ME_long_random_secret

# --- URLs publiques (utilisées dans les emails / liens) ---
CLIENT_PORTAL_BASE_URL=https://votre-domaine.fr
ADMIN_DASHBOARD_URL=https://votre-domaine.fr/admin

# --- Email transactionnel (Brevo) ---
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_NAME=Bryan Cars Detailing
MAIL_FROM_EMAIL=contact@votre-domaine.fr
MAIL_ADMIN_TO=admin@votre-domaine.fr

# --- Paiements (SumUp) ---
SUMUP_API_KEY=your-sumup-api-key
SUMUP_MERCHANT_CODE=your-sumup-merchant-code
# JSON décrivant les offres de recharge (voir src/config/topupOffers.js)
SUMUP_TOPUP_OFFERS=[]

# --- Notifications Web Push (VAPID) ---
# Générer une paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# --- Stockage (optionnel — valeurs par défaut si non défini) ---
# DATA_DIR=./data
# DB_FILE=./data/blackbox.db
# UPLOADS_DIR=./data/uploads
# FOUNDER_IMAGE_SOURCE=
# SEED_DEMO_CLIENT=

# --- Front (build Vite, à définir avant `npm run build` dans web/) ---
# VITE_SUMUP_TOPUP_URL=https://checkout.sumup.com/...
